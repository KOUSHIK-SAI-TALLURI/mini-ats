generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Stage {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

model Candidate {
  id        String        @id @default(cuid())
  name      String
  email     String        @unique
  phone     String?
  role      String
  source    String?
  resumeUrl String?
  notes     String?
  stage     Stage         @default(APPLIED)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  history   StageChange[]

  @@index([stage])
  @@index([name])
}

model StageChange {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  fromStage   Stage?
  toStage     Stage
  changedAt   DateTime  @default(now())
}